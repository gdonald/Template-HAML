
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::X;
use Test;

plan 23;

is HAML.render(:src("= 1 + 2\n")), "3\n", '= simple arithmetic';
is HAML.render(:src("= 'hi'\n")),  "hi\n", '= literal string';

is HAML.render(:src("= \$name\n"),    :locals(%(:name<World>))),    "World\n",   '= reads local';
is HAML.render(:src("= \$x * \$y\n"), :locals(%(:x(3), :y(4)))),    "12\n",      '= reads multiple locals';

is HAML.render(:src("= '<b>x</b>'\n")), "&lt;b&gt;x&lt;/b&gt;\n", '= HTML-escapes output';

is HAML.render(:src("!= '<b>x</b>'\n")), "<b>x</b>\n", '!= leaves raw HTML';

is HAML.render(:src("&= '<b>x</b>'\n")), "&lt;b&gt;x&lt;/b&gt;\n", '&= escapes output';

is HAML.render(:src("- 1 + 2\n")), '', '- emits nothing';

is HAML.render(:src("- my \$x = 1\n%p hi\n")), "<p>hi</p>\n", '- silent does not break sibling rendering';

is HAML.render(:src("%div\n  = 1 + 1\n")), "<div>\n  2\n</div>\n", '= respects indent within tag';

is HAML.render(:src("= 'a' ~ 'b'\n")), "ab\n", '= string concat';

is HAML.render(:src("= Nil\n")), "\n", '= Nil emits empty';
is HAML.render(:src("= 0\n")),   "0\n", '= 0 emits 0';

is HAML.render(
  :src("%ul\n  = \$item\n"),
  :locals(%(:item<one>)),
), "<ul>\n  one\n</ul>\n", 'locals visible inside nested block';

is HAML.render(
  :src("- my \$count = 5\n%p hi\n"),
), "<p>hi</p>\n", '- can declare a lexical without affecting other lines';

is HAML.render(:src("= 1\n= 2\n= 3\n")), "1\n2\n3\n", 'multiple = lines emit each';

throws-like { HAML.render(:src("= no_such_sub_xyzzy()\n")) }, X::HAML::Eval,
  'undefined sub raises X::HAML::Eval';

is HAML.render(
  :src("= \$items.elems\n"),
  :locals(%(:items([1,2,3,4]))),
), "4\n", '= sees array-typed local';

is HAML.render(
  :src("= \$cfg<title>\n"),
  :locals(%(:cfg(%(:title<Hello>)))),
), "Hello\n", '= sees hash-typed local';

is HAML.render(:src("= True\n")),  "True\n",  '= renders True';
is HAML.render(:src("= False\n")), "False\n", '= renders False';

sub trap-eval(&body) {
  try { body(); CATCH { when X::HAML::Eval { return $_ } } }
  Nil;
}
my $err = trap-eval({ HAML.render(:src("\n= no_such_sub_xyzzy()\n")) });
ok $err.defined,                  'caught X::HAML::Eval';
ok $err.line == 2,                'X::HAML::Eval has source line';
