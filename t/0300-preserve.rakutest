
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::Config;
use Test;

plan 10;

sub render(Str $src, *%args) { HAML.render(:$src, |%args) }

is render("%pre\n  Line 1\n  Line 2\n"),
   "<pre>&#x000A;  Line 1&#x000A;  Line 2&#x000A;</pre>\n",
   'pre tag preserves inner whitespace as &#x000A;';

is render("%textarea\n  hello\n  world\n"),
   "<textarea>&#x000A;  hello&#x000A;  world&#x000A;</textarea>\n",
   'textarea preserves inner whitespace';

is render("%pre Just text\n"),
   "<pre>Just text</pre>\n",
   'pre with single-line content unchanged';

is render("%div\n  %pre\n    text\n"),
   "<div>\n  <pre>&#x000A;    text&#x000A;  </pre>\n</div>\n",
   'pre nested in div preserves whitespace';

my $cfg = Template::HAML::Config.new(:preserve('custom-pre',));
is render("%custom-pre\n  hi\n", :config($cfg)),
   "<custom-pre>&#x000A;  hi&#x000A;</custom-pre>\n",
   'custom preserve element honored via config';

my $cfg2 = Template::HAML::Config.new(:preserve('textarea',));
is render("%pre\n  hi\n", :config($cfg2)),
   "<pre>\n  hi\n</pre>\n",
   'pre not preserved when removed from preserve list';

is render("~ \"line1\\nline2\"\n"),
   "line1&#x000A;line2\n",
   '~ operator preserves newlines';

is render("~ 'no newlines here'\n"),
   "no newlines here\n",
   '~ operator with no newlines unchanged';

is render("%div\n  ~ \"a\\nb\"\n"),
   "<div>\n  a&#x000A;b\n</div>\n",
   '~ operator inside a tag';

is render("~ '<a>'\n"),
   "&lt;a&gt;\n",
   '~ operator html-escapes by default';
