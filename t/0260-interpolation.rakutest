
use v6.d;
use lib 'lib';
use Template::HAML;
use Test;

plan 27;

is HAML.render(:src(Q[%p Hello, #{$name}!] ~ "\n"), :locals(%(name => 'world'))),
   "<p>Hello, world!</p>\n",
   '#{...} in tag content';

is HAML.render(:src(Q[%p Count: #{$n}] ~ "\n"), :locals(%(n => 42))),
   "<p>Count: 42</p>\n",
   '#{...} with numeric value';

is HAML.render(:src(Q[%p \#{x}] ~ "\n")),
   Q[<p>#{x}</p>] ~ "\n",
   '\\#{...} produces literal #{...}';

is HAML.render(:src(Q[%p !{$raw}] ~ "\n"), :locals(%(raw => '<b>bold</b>'))),
   "<p><b>bold</b></p>\n",
   '!{...} non-escaped interpolation';

is HAML.render(:src(Q[%p #{$tag}] ~ "\n"), :locals(%(tag => '<b>'))),
   "<p>&lt;b&gt;</p>\n",
   '#{...} HTML-escapes value';

is HAML.render(:src(Q[%p Two: #{1+1} and three: #{1+2}] ~ "\n")),
   "<p>Two: 2 and three: 3</p>\n",
   'multiple interpolations on one line';

is HAML.render(
  :src(Q[%a{href: "/users/#{$id}"}link] ~ "\n"),
  :locals(%(id => 7))
),
   "<a href='/users/7'>link</a>\n",
   '#{...} inside double-quoted attr value';

is HAML.render(
  :src(Q[%a{title: 'Hello #{$name}'}link] ~ "\n"),
  :locals(%(name => 'foo'))
),
   Q[<a title='Hello #{$name}'>link</a>] ~ "\n",
   'no interpolation in single-quoted strings';

is HAML.render(
  :src(Q[%a{href: "/q?x=#{$v}"}link] ~ "\n"),
  :locals(%(v => 'a&b'))
),
   "<a href='/q?x=a&amp;b'>link</a>\n",
   'interpolated attr value is HTML-escaped';

is HAML.render(:src(Q[Hello, #{$name}!] ~ "\n"), :locals(%(name => 'world'))),
   "Hello, world!\n",
   '#{...} in plain text';

is HAML.render(:src(Q[!{$raw}] ~ "\n"), :locals(%(raw => '<x>'))),
   "<x>\n",
   '!{...} in plain text';

is HAML.render(:src(Q[#{$x}] ~ "\n"), :locals(%(x => '<x>'))),
   "&lt;x&gt;\n",
   '#{...} in plain text escapes';

is HAML.render(:src(Q[%p #{$s}] ~ "\n"), :locals(%(s => '&'))),
   "<p>&amp;</p>\n",
   '& is escaped';

is HAML.render(:src(Q[%p #{$s}] ~ "\n"), :locals(%(s => '<'))),
   "<p>&lt;</p>\n",
   '< is escaped';

is HAML.render(:src(Q[%p #{$s}] ~ "\n"), :locals(%(s => '>'))),
   "<p>&gt;</p>\n",
   '> is escaped';

is HAML.render(:src(Q[%p #{$s}] ~ "\n"), :locals(%(s => '"'))),
   "<p>&quot;</p>\n",
   '" is escaped';

is HAML.render(:src(Q[%p #{$s}] ~ "\n"), :locals(%(s => "'"))),
   "<p>&#39;</p>\n",
   "' is escaped";

is HAML.render(:src(Q[%p !{$s}] ~ "\n"), :locals(%(s => '<&>'))),
   "<p><&></p>\n",
   '!{} does not escape HTML chars';

is HAML.render(:src("%div\n" ~ Q[  Hello, #{$name}!] ~ "\n"),
   :locals(%(name => 'foo'))),
   "<div>\n  Hello, foo!\n</div>\n",
   '#{...} in indented plain text';

is HAML.render(
  :src(Q[%a(href="/u/#{$id}")go] ~ "\n"),
  :locals(%(id => 5))
),
   "<a href='/u/5'>go</a>\n",
   'HTML-attr style double-quoted value supports interp';

is HAML.render(
  :src(Q[%a(title='a #{1}')go] ~ "\n")
),
   Q[<a title='a #{1}'>go</a>] ~ "\n",
   'HTML-attr style single-quoted value does not interp';

is HAML.render(:src(Q[%a{title: "x\ny"}go] ~ "\n")),
   "<a title='x\ny'>go</a>\n",
   '\\n still decodes when no interp markers';

is HAML.render(:src(Q[%a{title: "x\ny#{$v}"}go] ~ "\n"),
                :locals(%(v => 'Z'))),
   "<a title='x\nyZ'>go</a>\n",
   '\\n decodes inside string with interp';

is HAML.render(:src(Q[%a{title: "literal \#{x}"}go] ~ "\n")),
   Q[<a title='literal #{x}'>go</a>] ~ "\n",
   '\\#{...} in attrs is literal';

is HAML.render(:src(Q[== Hello, #{$name}!] ~ "\n"),
                :locals(%(name => 'world'))),
   "Hello, world!\n",
   '== is plain content with interpolation';

is HAML.render(:src(Q[== Plain text without interp] ~ "\n")),
   "Plain text without interp\n",
   '== without interp emits literal text';

is HAML.render(:src(Q[== !{$x}] ~ "\n"),
                :locals(%(x => '<b>'))),
   "<b>\n",
   '== supports !{} too';
