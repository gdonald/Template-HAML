
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::Config;
use Template::HAML::Eval;
use Template::HAML::X;
use Test;

plan 56;

sub catch-it(&block) {
  my $caught;
  {
    CATCH { default { $caught = $_; } }
    block();
  }
  $caught;
}

{
  my $e = X::HAML.new(:line(7), :column(3), :file('foo.haml'), :snippet('%bad'));
  is $e.line,    7,         'X::HAML.line';
  is $e.column,  3,         'X::HAML.column';
  is $e.file,    'foo.haml', 'X::HAML.file';
  is $e.snippet, '%bad',    'X::HAML.snippet';
  is $e.loc,     '[HAML foo.haml:7:3]', 'X::HAML.loc';
  ok $e.caret.contains('^'), 'X::HAML.caret has pointer';
  ok $e.caret.contains('%bad'), 'X::HAML.caret shows snippet';
}

{
  for X::HAML::ParseFail, X::HAML::IndentMixed, X::HAML::IllegalIndent,
      X::HAML::DuplicateId, X::HAML::DoctypeNotFirst -> $cls {
    my $e = $cls.new(:line(2), :column(1), :file('a.haml'), :snippet('  bad'));
    is $e.line,    2,        $cls.^name ~ ' inherits line';
    is $e.column,  1,        $cls.^name ~ ' inherits column';
    is $e.snippet, '  bad', $cls.^name ~ ' inherits snippet';
  }
}

{
  my $e = X::HAML::IndentInconsistent.new(
    :line(3), :column(1), :unit(2), :got(3), :snippet('   x'),
  );
  is $e.unit, 2, 'IndentInconsistent.unit';
  is $e.got,  3, 'IndentInconsistent.got';
  ok $e.message.contains('expected a multiple of 2'), 'IndentInconsistent.message';
  ok $e.message.contains('^'), 'IndentInconsistent shows caret';
}

{
  my $e = catch-it({ HAML.render(:src("\%9bad\n")) });
  isa-ok $e, X::HAML, 'parse failure raises X::HAML';
  ok $e.line.defined,   'parse failure has line';
  ok $e.column.defined, 'parse failure has column';
}

{
  my $src = "\%p hello\n\%9bad\n";
  my $e = catch-it({ HAML.render(:src($src)) });
  isa-ok $e, X::HAML::ParseFail, 'multi-line parse fail';
  ok $e.message.contains('parse failed'), 'message says parse failed';
  ok $e.snippet.defined, 'parse failure snippet defined';
}

{
  my $src = "\%p\n  \%a hi\n\t\%b bye\n";
  my $e = catch-it({ HAML.render(:src($src)) });
  isa-ok $e, X::HAML::IndentMixed, 'mixed indent raises IndentMixed';
  is $e.line,   3,           'mixed indent line';
  is $e.column, 1,           'mixed indent column';
  ok $e.snippet.defined,     'mixed indent snippet defined';
}

{
  my $src = "\%p\n  \%a hi\n   \%b bye\n";
  my $e = catch-it({ HAML.render(:src($src)) });
  isa-ok $e, X::HAML::IndentInconsistent, 'inconsistent indent raises';
  is $e.line, 3, 'inconsistent indent line';
}

{
  my $src = "\%p hi\n!!! 5\n";
  my $e = catch-it({ HAML.render(:src($src)) });
  isa-ok $e, X::HAML::DoctypeNotFirst, 'doctype-not-first raises';
  is $e.line, 2, 'doctype-not-first line';
  ok $e.snippet.defined, 'doctype-not-first snippet defined';
}

{
  my $e = catch-it({ HAML.render(:src("!!! Bogus\n")) });
  isa-ok $e, X::HAML::UnknownDoctype, 'unknown doctype raises';
  is $e.arg, 'Bogus', 'UnknownDoctype.arg';
}

{
  my $e = catch-it({ HAML.render(:src(":nope\n  body\n")) });
  isa-ok $e, X::HAML::UnknownFilter, 'unknown filter raises';
  is $e.name, 'nope', 'UnknownFilter.name';
}

{
  my $src = "\%br\n  \%span hi\n";
  my $e = catch-it({ HAML.render(:src($src)) });
  isa-ok $e, X::HAML::VoidWithChildren, 'void+children raises';
  is $e.name, 'br', 'VoidWithChildren.name';
}

{
  my $e = catch-it({ HAML.render(:src("- else\n  \%p hi\n")) });
  isa-ok $e, X::HAML::OrphanElse, 'orphan else raises';
  is $e.kind, 'else', 'OrphanElse.kind';
}

{
  my $e = catch-it({ eval-haml('die "boom"', %(), :line(5), :column(2)) });
  isa-ok $e, X::HAML::Eval, 'eval error raises';
  is $e.line, 5, 'Eval.line';
  is $e.column, 2, 'Eval.column';
  ok $e.code.defined, 'Eval.code';
}

{
  my $haml = HAML.new;
  my $e = catch-it({ $haml.render(:file('does-not-exist')) });
  isa-ok $e, X::HAML::TemplateNotFound, 'missing template raises';
  is $e.name, 'does-not-exist', 'TemplateNotFound.name';
}

{
  %*ENV<HAML_DEBUG>:delete;
  lives-ok { haml-debug('quiet') }, 'haml-debug no-op when HAML_DEBUG unset';
}
