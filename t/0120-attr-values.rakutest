
use v6.d;
use lib 'lib';
use Template::HAML;
use Test;

plan 7;

is HAML.render(:src("%a\{tabindex: 1\}\n")),
   "<a tabindex='1'></a>\n",
   'bare number value';

is HAML.render(:src("%a\{n: -3\}\n")),
   "<a n='-3'></a>\n",
   'negative number';

is HAML.render(:src("%a\{x: 1.5\}\n")),
   "<a x='1.5'></a>\n",
   'decimal number';

is HAML.render(:src("%a\{class: ['foo', 'bar']\}\n")),
   "<a class='foo bar'></a>\n",
   'array values for class join with space';

is HAML.render(:src("%a\{id: ['one', 'two']\}\n")),
   "<a id='one_two'></a>\n",
   'array values for id join with underscore';

is HAML.render(:src("%a\{title: \"line\\nbreak\"\}\n")),
   "<a title='line\nbreak'></a>\n",
   '\\n in double-quoted decodes to newline';

is HAML.render(:src("%a\{title: 'a\\\\b'\}\n")),
   "<a title='a\\b'></a>\n",
   '\\\\ decodes to single backslash';
