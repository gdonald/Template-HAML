
use v6.d;
use lib 'lib';
use Test;
use Template::HAML::Lint;
use Template::HAML::CLI;

plan 19;

sub diags-for(:$src, :%locals --> List) {
  my $rule   = Template::HAML::Lint::UnusedLocalsRule.new;
  my $linter = Template::HAML::Lint::Linter.new(:rules(($rule,)));
  $linter.lint(:$src, :%locals).list;
}

{
  my @d = diags-for(:src("%p hi\n"));
  is @d.elems, 0, 'no locals → no unused-locals diagnostics';
}

{
  my @d = diags-for(:src("%p Hello \#\{\$name\}\n"), :locals{ :name<Alice> });
  is @d.elems, 0, 'used local → no diagnostic';
}

{
  my @d = diags-for(:src("%p hi\n"), :locals{ :name<Alice> });
  is @d.elems, 1, 'unused local → one diagnostic';
  is @d[0].rule, 'unused-locals', 'rule id is unused-locals';
  is @d[0].severity, 'warning', 'severity is warning';
  like @d[0].message, /'$name'/, 'message names the unused local';
}

{
  my @d = diags-for(
    :src("%p Hi \#\{\$name\}\n"),
    :locals{ :name<x>, :age(30), :role<admin> },
  );
  is @d.elems, 2, 'two unused locals → two diagnostics';
  my @names = @d.map(*.message).sort;
  ok @names[0] ~~ /'$age'/,  'first diagnostic names $age';
  ok @names[1] ~~ /'$role'/, 'second diagnostic names $role';
}

{
  my @d = diags-for(
    :src("= \$total + 1\n"),
    :locals{ :total(42) },
  );
  is @d.elems, 0, 'expression reference counts as used';
}

{
  my @d = diags-for(
    :src("- my \$x = \$base * 2\n"),
    :locals{ :base(10) },
  );
  is @d.elems, 0, 'reference inside silent-script counts as used';
}

{
  my @d = diags-for(
    :src("%a\{href: \"\#\{\$url\}\"\} link\n"),
    :locals{ :url('/x') },
  );
  is @d.elems, 0, 'attribute-hash reference counts as used';
}

{
  my @d = diags-for(
    :src("%p Hi \#\{\$foobar\}\n"),
    :locals{ :foo(1), :foobar(2) },
  );
  is @d.elems, 1, 'word-boundary respected: $foo not satisfied by $foobar';
  like @d[0].message, /'$foo'/, 'diagnostic is about $foo, not $foobar';
}

sub capture(@args) {
  my $tmp     = $*TMPDIR.add("haml-ul-out-{$*PID}-{(^999999).pick}");
  my $tmp-err = $*TMPDIR.add("haml-ul-err-{$*PID}-{(^999999).pick}");
  my $out = $tmp.open(:w);
  my $err = $tmp-err.open(:w);
  my $exit = Template::HAML::CLI::run(@args, :$out, :$err);
  $out.close;
  $err.close;
  my $out-text = $tmp.slurp;
  my $err-text = $tmp-err.slurp;
  $tmp.unlink;
  $tmp-err.unlink;
  { :$exit, :out($out-text), :err($err-text) };
}

{
  my $dir  = $*TMPDIR.add("haml-ul-{$*PID}-{(^999999).pick}");
  $dir.mkdir;
  my $file = $dir.add('greet.haml');
  $file.spurt("%p Hi \#\{\$name\}\n");

  my $r = capture(['lint', '--locals', 'name,age', $file.Str]);
  is $r<exit>, 1, 'unused local triggers non-zero exit';
  like $r<out>, /'unused-locals'/, 'output names the rule';
  like $r<out>, /'$age'/, 'output names the unused local';

  my $r2 = capture(['lint', '--locals', 'name', $file.Str]);
  is $r2<exit>, 0, 'all-used → exit 0';
  is $r2<out>, '', 'no diagnostic output when all used';

  $file.unlink;
  $dir.rmdir;
}
