
use v6.d;
use lib 'lib';
use Template::HAML;
use Test;

plan 4;

is HAML.render(:src(Q<%a{title: 't', class: 'c', id: 'i', href: '/'}> ~ "\n")),
   "<a id='i' class='c' title='t' href='/'></a>\n",
   'id, class first; rest in insertion order';

is HAML.render(:src(Q<%a{c: 3, a: 1, b: 2}> ~ "\n")),
   "<a c='3' a='1' b='2'></a>\n",
   'insertion order preserved';

is HAML.render(:src(Q<%a#main{href: '/', class: 'cls'}> ~ "\n")),
   "<a id='main' class='cls' href='/'></a>\n",
   'id from shorthand still emitted first';

is HAML.render(:src(Q<%a.foo{href: '/', id: 'm'}> ~ "\n")),
   "<a id='m' class='foo' href='/'></a>\n",
   'class from shorthand still after id';
