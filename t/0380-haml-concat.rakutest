
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::Helpers;
use Test;

plan 7;

my $r = HAML.render(:src(q:to/HAML/));
= haml-concat('<b>x</b>')
HAML
is $r, "<b>x</b>\n", '= haml-concat emits unescaped value';

$r = HAML.render(:src(q:to/HAML/));
- haml-concat('one')
- haml-concat('two')
HAML
is $r, "one\ntwo\n", '- haml-concat emits buffered content from silent statements';

$r = HAML.render(:src(q:to/HAML/));
- haml-concat('a'); haml-concat('b'); haml-concat('c')
HAML
is $r, "abc\n", 'multiple haml-concat calls accumulate in one statement';

$r = HAML.render(:src(q:to/HAML/));
= do { haml-concat('pre-'); 'ret' }
HAML
is $r, "pre-ret\n", 'buffer flushes before return value on `=`';

$r = HAML.render(:src(q:to/HAML/));
= haml-concat('<&>')
HAML
is $r, "<&>\n", 'haml-concat return is SafeString (no escape)';

$r = HAML.render(:src(q:to/HAML/));
%p
  = haml-concat('hi')
HAML
is $r, "<p>\n  hi\n</p>\n", 'haml-concat inside a tag indents output';

my $ss = haml-concat('<a>');
isa-ok $ss, Template::HAML::Helpers::SafeString, 'haml-concat outside eval returns SafeString';
