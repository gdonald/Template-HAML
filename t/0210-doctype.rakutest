
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::X;
use Test;

plan 13;

is HAML.render(:src("!!! 5\n")),
   "<!DOCTYPE html>\n",
   '!!! 5 → HTML5 doctype';

is HAML.render(:src("!!!\n")),
   "<!DOCTYPE html>\n",
   '!!! with no arg defaults to HTML5 doctype';

is HAML.render(:src("!!! 1.1\n")),
   '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">' ~ "\n",
   '!!! 1.1 → XHTML 1.1';

is HAML.render(:src("!!! Strict\n")),
   '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">' ~ "\n",
   '!!! Strict → XHTML 1.0 Strict';

is HAML.render(:src("!!! Frameset\n")),
   '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Frameset//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-frameset.dtd">' ~ "\n",
   '!!! Frameset → XHTML 1.0 Frameset';

is HAML.render(:src("!!! Mobile\n")),
   '<!DOCTYPE html PUBLIC "-//WAPFORUM//DTD XHTML Mobile 1.2//EN" "http://www.openmobilealliance.org/tech/DTD/xhtml-mobile12.dtd">' ~ "\n",
   '!!! Mobile → XHTML Mobile 1.2';

is HAML.render(:src("!!! RDFa\n")),
   '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML+RDFa 1.0//EN" "http://www.w3.org/MarkUp/DTD/xhtml-rdfa-1.dtd">' ~ "\n",
   '!!! RDFa → XHTML+RDFa 1.0';

is HAML.render(:src("!!! Basic\n")),
   '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML Basic 1.1//EN" "http://www.w3.org/TR/xhtml-basic/xhtml-basic11.dtd">' ~ "\n",
   '!!! Basic → XHTML Basic 1.1';

is HAML.render(:src("!!! XML\n")),
   "<?xml version='1.0' encoding='utf-8' ?>\n",
   '!!! XML → utf-8 default';

is HAML.render(:src("!!! XML iso-8859-1\n")),
   "<?xml version='1.0' encoding='iso-8859-1' ?>\n",
   '!!! XML iso-8859-1 → custom encoding';

is HAML.render(:src("!!! 5\n%html\n")),
   "<!DOCTYPE html>\n<html></html>\n",
   'doctype renders before the first tag';

throws-like { HAML.render(:src("!!! Bogus\n")) },
   X::HAML::UnknownDoctype,
   'unknown doctype variant raises X::HAML::UnknownDoctype';

throws-like { HAML.render(:src("%p hi\n!!! 5\n")) },
   X::HAML::DoctypeNotFirst,
   'doctype after content raises X::HAML::DoctypeNotFirst';
