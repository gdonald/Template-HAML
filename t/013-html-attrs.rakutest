
use v6.d;
use lib 'lib';
use Template::HAML;
use Test;

plan 6;

is HAML.render(:src(Q[%a(href='/')] ~ "\n")),
   "<a href='/'></a>\n",
   'HTML-style single-quoted value';

is HAML.render(:src(Q[%a(href="/")] ~ "\n")),
   "<a href='/'></a>\n",
   'HTML-style double-quoted value';

is HAML.render(:src(Q[%input(disabled)] ~ "\n")),
   "<input disabled>\n",
   'bool attr (no value) renders bare in HTML5';

is HAML.render(:src(Q<%a(href='/'){title: 'home'}> ~ "\n")),
   "<a href='/' title='home'></a>\n",
   'combine ()-attrs and {}-attrs';

is HAML.render(:src(Q[%a(href='/' title='home')] ~ "\n")),
   "<a href='/' title='home'></a>\n",
   'multiple HTML attrs in parens';

is HAML.render(:src(Q[%a(data-id='42')] ~ "\n")),
   "<a data-id='42'></a>\n",
   'hyphenated HTML attr name';
