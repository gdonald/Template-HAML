
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::Cache;
use Template::HAML::Config;
use Test;

plan 19;

sub fresh-dir(--> IO::Path) {
  my $base = $*TMPDIR.add('Template-HAML-mem-' ~ (now.Rat * 1_000_000).Int ~ '-' ~ ((^1_000_000).pick));
  $base.mkdir;
  $base;
}

sub fresh-haml-file(IO::Path $root, Str $body --> IO::Path) {
  my $f = $root.add('tpl-' ~ (^1_000_000).pick ~ '.haml');
  $f.spurt($body);
  $f;
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  is $haml.compiled-fn-cache-size, 0, 'fn cache starts at 0';
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  $haml.render-cached(:src("%p hi\n"));
  is $haml.compiled-fn-cache-size, 1, 'render-cached adds 1 fn entry';
  $haml.render-cached(:src("%p hi\n"));
  is $haml.compiled-fn-cache-size, 1, 'second call with same src does not grow cache';
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  $haml.render-cached(:src("%p one\n"));
  $haml.render-cached(:src("%p two\n"));
  is $haml.compiled-fn-cache-size, 2, 'different src yields distinct fn cache entries';
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  my $src   = "%br\n";
  my $cfg-a = Template::HAML::Config.new(:format<html5>);
  my $cfg-b = Template::HAML::Config.new(:format<xhtml>);
  $haml.render-cached(:$src, :config($cfg-a));
  $haml.render-cached(:$src, :config($cfg-b));
  is $haml.compiled-fn-cache-size, 2, 'different config yields distinct fn entries';
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  my $src  = "%p surviving\n";
  my $out1 = $haml.render-cached(:$src);
  my $path = $haml.compiled-cache-path(:$src);
  ok $path.e, 'cache file exists after first render';
  $path.unlink;
  ok !$path.e, 'cache file removed';
  my $out2 = $haml.render-cached(:$src);
  is $out2, $out1, 'second render still works without disk file (fn memoized in-process)';
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  $haml.render-cached(:src("%p a\n"));
  $haml.render-cached(:src("%p b\n"));
  is $haml.clear-compiled-fn-cache, 2, 'clear-compiled-fn-cache returns count';
  is $haml.compiled-fn-cache-size, 0, 'fn cache empty after clear';
}

{
  my $dir  = fresh-dir;
  my $haml = HAML.new(:compiled-cache-dir($dir));
  $haml.clear-compiled-fn-cache;
  $haml.render-cached(:src("%p x\n"));
  is $haml.compiled-fn-cache-size, 1, 'fn cache populated';
  $haml.clear-compiled-cache;
  is $haml.compiled-fn-cache-size, 0, 'clear-compiled-cache also clears fn cache';
}

{
  my $dir  = fresh-dir;
  my $tpl  = fresh-haml-file($dir, "%p file-memoization\n");
  my $haml = HAML.new(:compiled-cache-dir($dir.add('cache')));
  $haml.clear-compiled-fn-cache;
  $haml.render-file-cached(:file($tpl.absolute));
  is $haml.compiled-fn-cache-size, 1, 'render-file-cached populates fn cache';
  $haml.render-file-cached(:file($tpl.absolute));
  is $haml.compiled-fn-cache-size, 1, 'second call does not grow cache';
}

{
  my $dir  = fresh-dir;
  my $tpl  = fresh-haml-file($dir, "%p one\n");
  my $haml = HAML.new(:compiled-cache-dir($dir.add('cache')));
  $haml.clear-compiled-fn-cache;
  is $haml.render-file-cached(:file($tpl.absolute)), "<p>one</p>\n",
     'initial file-based render';
  sleep 1.1;
  $tpl.spurt("%p two\n");
  is $haml.render-file-cached(:file($tpl.absolute)), "<p>two</p>\n",
     'mtime change yields a fresh fn (new key, no stale memo)';
  is $haml.compiled-fn-cache-size, 2, 'old and new entries both present';
}

{
  my $dir1 = fresh-dir;
  my $dir2 = fresh-dir;
  my $h1   = HAML.new(:compiled-cache-dir($dir1));
  my $h2   = HAML.new(:compiled-cache-dir($dir2));
  $h1.clear-compiled-fn-cache;
  $h1.render-cached(:src("%p shared\n"));
  is $h2.compiled-fn-cache-size, 1, 'second instance sees the memoized entry';
  $h2.render-cached(:src("%p shared\n"));
  is $h2.compiled-fn-cache-size, 1, 'second instance does not duplicate the entry';
}
