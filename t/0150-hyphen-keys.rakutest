
use v6.d;
use lib 'lib';
use Template::HAML;
use Template::HAML::X;
use Test;

plan 3;

is HAML.render(:src(Q[%a{'data-id' => 1}] ~ "\n")),
   "<a data-id='1'></a>\n",
   'hyphenated string key with rocket';

is HAML.render(:src(Q[%a{"aria-label" => "x"}] ~ "\n")),
   "<a aria-label='x'></a>\n",
   'hyphenated double-quoted string key';

throws-like { HAML.render(:src(Q[%a{data-id: 1}] ~ "\n")) },
            X::HAML::ParseFail,
            'bareword hyphen key raises ParseFail';
