
use v6.d;
use lib 'lib';
use Template::HAML;
use Test;

plan 5;

is HAML.render(:src(Q[%a{title: 'tom & jerry'}] ~ "\n")),
   "<a title='tom &amp; jerry'></a>\n",
   '& is escaped';

is HAML.render(:src(Q[%a{title: '<script>'}] ~ "\n")),
   "<a title='&lt;script&gt;'></a>\n",
   '< and > are escaped';

is HAML.render(:src(Q[%a{title: "don't"}] ~ "\n")),
   "<a title='don&#39;t'></a>\n",
   'single quote inside value escaped to &#39;';

is HAML.render(:src(Q[%a{title: 'a "quoted" word'}] ~ "\n")),
   "<a title='a &quot;quoted&quot; word'></a>\n",
   'double quote escaped to &quot;';

is HAML.render(:src(Q[%a{title: 'a & b < c'}] ~ "\n")),
   "<a title='a &amp; b &lt; c'></a>\n",
   'combined escaping';
