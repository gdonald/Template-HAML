
use v6.d;
use lib 'lib';
use Template::HAML;
use Test;

plan 13;

# single-line HTML comment
is HAML.render(:src("/ Hello\n")),
   "<!-- Hello -->\n",
   'single-line HTML comment';

# single-line HTML comment with no text
is HAML.render(:src("/\n")),
   "<!---->\n",
   'HTML comment with no text and no children';

# block HTML comment with children
my $src1 = q:to/HAML/;
/
  %p hi
HAML

is HAML.render(:src($src1)),
   "<!--\n  <p>hi</p>\n-->\n",
   'block HTML comment wraps children';

# deeper indent and multiple children
my $src2 = q:to/HAML/;
%div
  /
    %p hi
    %p bye
HAML

is HAML.render(:src($src2)),
   "<div>\n  <!--\n    <p>hi</p>\n    <p>bye</p>\n  -->\n</div>\n",
   'nested block comment with multiple children';

# conditional comment
is HAML.render(:src("/[if IE] text\n")),
   "<!--[if IE]>text<![endif]-->\n",
   'inline conditional comment';

# conditional comment block
my $src3 = q:to/HAML/;
/[if IE]
  %p ie only
HAML

is HAML.render(:src($src3)),
   "<!--[if IE]>\n  <p>ie only</p>\n<![endif]-->\n",
   'block conditional comment';

# negated condition
is HAML.render(:src("/[if !IE] text\n")),
   "<!--[if !IE]>text<![endif]-->\n",
   'negated conditional';

# revealed conditional
is HAML.render(:src("/![if !IE] text\n")),
   "<!--[if !IE]><!-->text<!--<![endif]-->\n",
   'revealed conditional comment';

# silent comment - no output
is HAML.render(:src("-# silent\n")),
   "",
   'silent comment produces no output';

# silent comment with children - no output
my $src4 = q:to/HAML/;
-# silent
  some text
  more text
HAML

is HAML.render(:src($src4)),
   "",
   'silent comment with indented body produces no output';

# silent comment between tags
my $src5 = q:to/HAML/;
%p hi
-# this is a note
%p bye
HAML

is HAML.render(:src($src5)),
   "<p>hi</p>\n<p>bye</p>\n",
   'silent comment between siblings does not interfere';

# silent body is opaque - free-form text that would otherwise fail to parse
my $src6 = q:to/HAML/;
%div
  -# notes:
    arbitrary text $^&* not valid HAML
    !!! also opaque
  %p hi
HAML

is HAML.render(:src($src6)),
   "<div>\n  <p>hi</p>\n</div>\n",
   'silent comment body is opaque text, not parsed';

# silent comment with blank lines inside body
my $src7 = q:to/HAML/;
-# header
  body line

  body line two
HAML

is HAML.render(:src($src7)),
   "",
   'silent comment body may contain blank lines';
